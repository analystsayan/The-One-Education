# ---------------------------------------------------------------
# Copy to ".env" and fill in real values. Never commit .env
# ---------------------------------------------------------------

# Gemini API — free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# MySQL
DB_HOST=Hostname or IP address of your MySQL server
DB_PORT=Port number of your MySQL server (default: 3306)
DB_USER=admin username for your MySQL database
DB_PASSWORD=password for your MySQL database user
DB_NAME=mcq_app

# Server
PORT=3000
NODE_ENV=development

# Branding
SITE_NAME=The One Education
SITE_DOMAIN=practice.theoneeducation.com
